# MOCHU-OA V2.0 Git 忽略文件

# ==================== Java ====================
# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# ==================== Maven ====================
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# ==================== Gradle ====================
.gradle
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/

# ==================== Node.js ====================
# Dependencies
node_modules/
.pnp
.pnp.js

# Testing
coverage/

# Production
dist/
build/

# Misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==================== IDE ====================
# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr
out/

# Eclipse
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache
bin/
tmp/

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# VS Code
.vscode/
*.code-workspace

# ==================== 操作系统 ====================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ==================== 敏感文件 ====================
# 配置文件（包含密码等敏感信息）
application.yml
application.properties
application-*.yml
application-*.properties

# 但是保留模板文件
!application.yml.template
!application.properties.template

# 密钥文件
*.pem
*.key
*.crt
*.p12
*.jks

# ==================== 临时文件 ====================
# 日志文件
logs/
*.log
*.log.*

# 临时目录
tmp/
temp/

# ==================== 数据库 ====================
# 数据库文件
*.db
*.sqlite
*.sqlite3

# ==================== 其他 ====================
# 编译输出
out/
output/

# 打包文件
*.tar
*.tar.gz
*.zip
*.rar

# 备份文件
*.bak
*.backup
*.old

# AI 相关（避免提交大型模型文件）
models/
*.model
*.weights

# 任务状态文件（根据需要可以忽略）
# task.json
# progress.txt
